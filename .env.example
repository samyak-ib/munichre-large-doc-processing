# Copy to .env and fill in.
#
# Each model calls its own vendor directly when that vendor's key is set below,
# and falls back to the SuperApp Responses API when it is not. Direct is
# preferred: the call reaches the model it names, and reports real token counts.

# https://platform.openai.com/api-keys — serves the openai/* pins.
OPENAI_API_KEY=

# https://aistudio.google.com/apikey — serves the gemini/* pins.
GEMINI_API_KEY=

# The fallback route, needed only for models no direct key covers. A SuperApp
# bearer token (Auth0 JWT): grab it from a logged-in SuperApp session —
# DevTools > Network > any /api request > Authorization header, minus the
# "Bearer " prefix. It expires; on a 401 the CLI asks for a fresh one.
SUPERAPP_TOKEN=

# Optional: overrides config.yaml api.base_url
# SUPERAPP_BASE_URL=https://superapp.instabase.com/api/v1
